<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp"
    android:paddingStart="16dp" android:paddingEnd="8dp" android:paddingVertical="8dp"
    android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/row_ripple">
    <TextView android:id="@+id/row_text" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textSize="16sp" android:textColor="@color/on_surface"
        android:lineSpacingExtra="2sp" android:drawablePadding="16dp" android:drawableTint="@color/primary" />
    <ImageButton android:id="@+id/row_up" style="@style/IconButton" android:visibility="gone" android:src="@drawable/ic_up"
        android:contentDescription="@string/move_up" />
    <ImageButton android:id="@+id/row_down" style="@style/IconButton" android:visibility="gone" android:src="@drawable/ic_down"
        android:contentDescription="@string/move_down" />
    <ImageButton android:id="@+id/row_remove" style="@style/IconButton" android:visibility="gone" android:src="@drawable/ic_close"
        android:contentDescription="@string/remove" />
    <ImageView android:id="@+id/row_chevron" android:layout_width="24dp" android:layout_height="24dp"
        android:layout_marginHorizontal="8dp" android:src="@drawable/ic_chevron" android:visibility="gone"
        android:tint="@color/on_surface_variant" android:importantForAccessibility="no" />
</LinearLayout>
