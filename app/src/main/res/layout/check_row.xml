<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="44dp" android:gravity="center_vertical" android:orientation="horizontal"
    android:screenReaderFocusable="true">
    <ImageView android:id="@+id/check_icon" android:layout_width="24dp" android:layout_height="24dp"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/check_label" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="16dp" android:textSize="16sp" />
    <TextView android:id="@+id/check_value" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
