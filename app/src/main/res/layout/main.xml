<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">

        <TextView android:id="@+id/app_title" style="@style/Text.Display" android:layout_marginTop="32dp"
            android:paddingStart="16dp" android:text="@string/app_name" android:accessibilityHeading="true" />
        <TextView style="@style/Text.Supporting" android:paddingStart="16dp" android:layout_marginTop="4dp"
            android:text="@string/tagline" />

        <LinearLayout android:id="@+id/status_card" style="@style/Card" android:layout_marginTop="24dp"
            android:paddingHorizontal="16dp" android:paddingVertical="24dp">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp"
                android:importantForAccessibility="noHideDescendants">
                <ImageView android:id="@+id/status_icon" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:padding="12dp"
                    android:background="@drawable/circle" />
                <ProgressBar android:id="@+id/status_progress" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:padding="8dp" android:indeterminate="true"
                    android:indeterminateTint="@color/primary" android:visibility="gone" />
            </FrameLayout>
            <TextView android:id="@+id/status_title" style="@style/Text.Headline" android:layout_marginTop="16dp"
                android:accessibilityHeading="true" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/status" style="@style/Text.Body" android:layout_marginTop="4dp"
                android:accessibilityLiveRegion="polite" />

            <LinearLayout android:id="@+id/routes" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
                <include android:id="@+id/route_mic" layout="@layout/route_row" />
                <include android:id="@+id/route_headphones" layout="@layout/route_row" />
            </LinearLayout>
            <HorizontalScrollView android:id="@+id/chips_scroll" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp" android:scrollbars="none">
                <RadioGroup android:id="@+id/chips" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:contentDescription="@string/for_this_call" />
            </HorizontalScrollView>

            <LinearLayout android:id="@+id/setup" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
                <include android:id="@+id/step_install" layout="@layout/step" />
                <include android:id="@+id/step_start" layout="@layout/step" />
                <include android:id="@+id/step_connect" layout="@layout/step" />
            </LinearLayout>

        </LinearLayout>

        <TextView style="@style/Text.Section" android:text="@string/options" />
        <LinearLayout style="@style/Card">
            <LinearLayout style="@style/Row" android:orientation="horizontal" android:screenReaderFocusable="true">
                <TextView android:id="@+id/notifications_text" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:textSize="16sp"
                    android:textColor="@color/on_surface" android:lineSpacingExtra="2sp" />
                <Button android:id="@+id/allow_notifications" style="@style/Button.Tonal"
                    android:layout_marginStart="16dp" android:text="@string/allow" />
            </LinearLayout>
            <LinearLayout style="@style/Row" android:orientation="horizontal" android:screenReaderFocusable="true">
                <TextView android:id="@+id/tile_text" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:textSize="16sp"
                    android:textColor="@color/on_surface" android:lineSpacingExtra="2sp" />
                <Button android:id="@+id/add_tile" style="@style/Button.Tonal" android:layout_marginStart="16dp"
                    android:text="@string/add_tile" />
            </LinearLayout>
            <TextView android:id="@+id/advanced" style="@style/Row.Link" android:drawableEnd="@drawable/ic_chevron" />
        </LinearLayout>

        <TextView style="@style/Text.Section" android:text="@string/help" />
        <LinearLayout style="@style/Card">
            <TextView android:id="@+id/how_it_works" style="@style/Row.Link"
                android:drawableStart="@drawable/ic_info" android:drawableEnd="@drawable/ic_open" />
            <TextView android:id="@+id/troubleshooting" style="@style/Row.Link"
                android:drawableStart="@drawable/ic_help" android:drawableEnd="@drawable/ic_open" />
            <TextView android:id="@+id/diagnostics" style="@style/Row.Link"
                android:drawableStart="@drawable/ic_copy" />
            <TextView android:id="@+id/report_problem" style="@style/Row.Link"
                android:drawableStart="@drawable/ic_bug" android:drawableEnd="@drawable/ic_open" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
